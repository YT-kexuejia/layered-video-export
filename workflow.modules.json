{
  "schemaVersion": 1,
  "visualBaseline": "studio-blue-v1",
  "timebase": "source-seconds",
  "modules": [
    {"id":"intake","dependsOn":[],"outputs":["config.json","environment-report.json"]},
    {"id":"speech","dependsOn":["intake"],"outputs":["transcript.json","transcript.txt","caption-draft.json"]},
    {"id":"editorial","dependsOn":["speech"],"outputs":["plan.json"]},
    {"id":"art-direction","dependsOn":["editorial"],"outputs":["visual-spec.json"]},
    {"id":"visual-code","dependsOn":["art-direction"],"outputs":["film.html","visual-build.json"]},
    {"id":"3d","dependsOn":["art-direction"],"outputs":["3d-build.json"]},
    {"id":"audio-captions","dependsOn":["speech","editorial"],"outputs":["captions.json","subtitles.srt"]},
    {"id":"render","dependsOn":["visual-code","3d","audio-captions"],"outputs":["render-manifest.json","preview-url","video.mp4"]},
    {"id":"review","dependsOn":["render"],"outputs":["qa-report.json"]}
  ],
  "qualityGates": {
    "timing": "visual-reveal-not-before-spoken-phrase",
    "canvas": "continuous-1920x1080-coverage",
    "transitionSamplesSeconds": [-0.1, 0, 0.1],
    "forbiddenArtifacts": ["black-band","alpha-seam","one-pixel-edge","background-discontinuity","stale-layer","hard-cut"],
    "encodedFrameRecheck": true
  }
}
